{
  "name": "@guardbot/chalk",
  "version": "3.0.0",
  "description": "A fast, colorful logger built for apps, with pretty & JSON output.",
  "type": "module",
  "main": "./build/index.cjs",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    }
  },
  "files": [
    "build",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "check:package": "attw --pack .",
    "bench": "yarn build && node bench/index.js",
    "dev": "tsx --env-file-if-exists=.env tests/index.ts",
    "typecheck": "tsc && tsc -p tests/tsconfig.json",
    "test": "yarn build && node --test \"tests/unit/**/*.test.js\"",
    "prepublishOnly": "yarn typecheck && yarn lint && yarn test && yarn check:package"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guardbotgg/chalk.git"
  },
  "keywords": [
    "logger",
    "logging",
    "chalk",
    "colors",
    "terminal",
    "json",
    "ndjson",
    "discord",
    "webhook"
  ],
  "license": "MIT",
  "author": "Aniket (github.com/aniket091)",
  "homepage": "https://github.com/guardbotgg/chalk#readme",
  "bugs": {
    "url": "https://github.com/guardbotgg/chalk/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "pino": "^10.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@1.22.22"
}
